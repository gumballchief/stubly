# Arc testnet connection (public values — safe to share)
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Contracts (Circle's deployments on Arc testnet — public constants)
ERC8183_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Explorer REST base (Blockscout)
EXPLORER_API=https://testnet.arcscan.app/api/v2

# Browser-facing explorer base. Only set this if it differs from the host above.
# EXPLORER=https://testnet.arcscan.app

# ---------------------------------------------------------------------------
# Arc MAINNET — opens 16 September 2026. Every value below is blank on purpose:
# Circle has not published the addresses yet, and a guessed address is worse
# than a missing one. The site serves both chains at once, so filling these in
# ADDS mainnet rather than replacing testnet — every published testnet job link
# keeps resolving. Until RPC, escrow and provider wallet are all set, the
# mainnet chain counts as unconfigured and can never be selected.
#
# Flip DEFAULT_CHAIN=mainnet once they are filled in and verified.
# ---------------------------------------------------------------------------
DEFAULT_CHAIN=testnet
MAINNET_CHAIN_ID=5042
MAINNET_RPC_URL=
# The endpoint written into visitors wallets by wallet_addEthereumChain.
# Must be the chain canonical public RPC, not a paid provider of ours.
MAINNET_PUBLIC_RPC_URL=
# Leave blank for Stubly's own escrow: npm run escrow:deploy writes chain/escrow-mainnet.json and the
# flip uses it. Set it only to use another escrow, e.g. Circle's once they deploy one on mainnet.
MAINNET_ERC8183=
# VERIFY on-chain rather than assuming the testnet predeploy address carries over.
MAINNET_USDC=
# The ERC-8004 team's mainnet registry, live on Arc: 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432 (the default).
MAINNET_IDENTITY_REGISTRY=
MAINNET_EXPLORER=
MAINNET_EXPLORER_API=
MAINNET_CIRCLE_CHAIN=ARC
# Addresses of the mainnet-only keystores (provider_mainnet / evaluator_mainnet).
# Never the testnet wallets: that key has lived on a laptop and in three CI
# environments, so it does not get to sign for real money.
MAINNET_PROVIDER_WALLET=
MAINNET_EVALUATOR_WALLET=
# Create the mainnet keystores with `npm run wallets:mainnet` (interactive: paste
# a key or make a new wallet, choose a password, all hidden). On a host they are
# handed in base64 under these names, derived from the wallet names:
# provider_mainnet becomes PROVIDER_MAINNET_KEYSTORE_B64. Copy one for pasting with
# `npm run wallets:mainnet -- --copy provider_mainnet`. Their password is
# KEYSTORE_PASSWORD_MAINNET, set in the host's dashboard and NEVER in this file.
# Do not load these until launch day — early upload buys nothing and lengthens
# the window they are exposed.
# KEYSTORE_PASSWORD_MAINNET=
# PROVIDER_MAINNET_KEYSTORE_B64=
# EVALUATOR_MAINNET_KEYSTORE_B64=

# Pay with $STUBLY (worker/tokenpay.js). OFF unless TOKENPAY=on. A buyer pays in the token, for less than
# the USDC price; Stubly's pay wallet (treasury_mainnet) funds the escrow in USDC for them. The tokens wait in
# the pay wallet until the order settles: delivered -> burned (or TOKENPAY_PAYOUT); refunded -> back to the buyer.
# Keep the pay wallet topped up with USDC (the token's tax income). Set these on the WORKER (Render):
# TOKENPAY=on
# TOKENPAY_TOKEN=0x...                          the token's contract address
# TOKENPAY_POOL=v4:<fee>:<tickSpacing>:<hooks>  or v3:<fee>, the token's USDC pool (prices each order)
# TOKENPAY_PAYOUT=burn                          default: burn delivered orders' tokens; or a wallet address
# TOKENPAY_DISCOUNT_BPS=2000                    how much cheaper paying in the token is (2000 = 20%, the default)
# TOKENPAY_MAX_USDC_PER_DAY=25                  most USDC the pay wallet puts into escrows per day
# TOKENPAY_MAX_USDC_PER_BUYER_PER_DAY=10
# TOKENPAY_MAX_OPEN=5                           orders in progress at once
# TOKENPAY_START_BLOCK=                         the block it was switched on (bounds the restart scan and the refill ledger)
# TOKENPAY_REFILL_EVERY=20                      the agent wallet sends the pay wallet back the USDC of every 20 delivered
#                                               token orders (sooner if the pay wallet drops under 3 USDC); 0 turns it off
# TREASURY_MAINNET_KEYSTORE_B64=                npm run wallets:mainnet -- --with-treasury, then --copy treasury_mainnet
# And on the SITE (Vercel), so order pages and profiles credit the buyer:
# MAINNET_PAY_WALLET=0x...                      the pay wallet's address
# MAINNET_PAY_TOKEN=0x...                       the token's address, for the "burned" counter on the homepage

# Cold address that receives swept earnings. Set this BEFORE mainnet: it caps
# what a stolen hot key can take to the working float. Unset = sweeping off.
SWEEP_TO=

# House-agent brain (Google Gemini — prepaid credit, Flash tier = fractions of a cent/job)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Password that encrypts the LOCAL TESTNET keystores created by make-wallets.js.
# Testnet-only convenience. Mainnet keystores never use it: their password is
# typed into `npm run wallets:mainnet`, and a host that must sign unattended gets
# it as KEYSTORE_PASSWORD_MAINNET in its own dashboard, never in this file.
KEYSTORE_PASSWORD=

# Circle user-controlled wallets (Stage 4)
CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Hosted deliverable storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=

# Publishing deliverables to the live site (worker -> site -> Vercel Blob)
SITE_URL=
PUBLISH_SECRET=

# Owner key for the /inbox page
ADMIN_KEY=
