# Arc testnet connection (public values — safe to share)
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Contracts (Circle's deployments on Arc testnet — public constants)
ERC8183_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Explorer REST base (Blockscout)
EXPLORER_API=https://testnet.arcscan.app/api/v2

# Browser-facing explorer base. Only set this if it differs from the host above.
# EXPLORER=https://testnet.arcscan.app

# ---------------------------------------------------------------------------
# Arc MAINNET — opens 16 September 2026. Every value below is blank on purpose:
# Circle has not published the addresses yet, and a guessed address is worse
# than a missing one. The site serves both chains at once, so filling these in
# ADDS mainnet rather than replacing testnet — every published testnet job link
# keeps resolving. Until RPC, escrow and provider wallet are all set, the
# mainnet chain counts as unconfigured and can never be selected.
#
# Flip DEFAULT_CHAIN=mainnet once they are filled in and verified.
# ---------------------------------------------------------------------------
DEFAULT_CHAIN=testnet
MAINNET_CHAIN_ID=5042
MAINNET_RPC_URL=
# The endpoint written into visitors wallets by wallet_addEthereumChain.
# Must be the chain canonical public RPC, not a paid provider of ours.
MAINNET_PUBLIC_RPC_URL=
MAINNET_ERC8183=
# VERIFY on-chain rather than assuming the testnet predeploy address carries over.
MAINNET_USDC=
MAINNET_IDENTITY_REGISTRY=
MAINNET_EXPLORER=
MAINNET_EXPLORER_API=
MAINNET_CIRCLE_CHAIN=ARC
# Addresses of the mainnet-only keystores (provider_mainnet / evaluator_mainnet).
# Never the testnet wallets: that key has lived on a laptop and in three CI
# environments, so it does not get to sign for real money.
MAINNET_PROVIDER_WALLET=
MAINNET_EVALUATOR_WALLET=
# On a host, the mainnet keystores are handed in base64 under these names. They
# are derived from the wallet names, which the chain id picks: provider_mainnet
# becomes PROVIDER_MAINNET_KEYSTORE_B64. Do not load these until launch day —
# early upload buys nothing and lengthens the window they are exposed.
# PROVIDER_MAINNET_KEYSTORE_B64=
# EVALUATOR_MAINNET_KEYSTORE_B64=

# Cold address that receives swept earnings. Set this BEFORE mainnet: it caps
# what a stolen hot key can take to the working float. Unset = sweeping off.
SWEEP_TO=

# House-agent brain (Google Gemini — prepaid credit, Flash tier = fractions of a cent/job)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Password that encrypts the LOCAL TESTNET keystores created by make-wallets.js.
# Testnet-only convenience. Mainnet keys must NEVER use an env password —
# use the interactive gold/protocol/airdrop/make-keystore.js flow instead.
KEYSTORE_PASSWORD=

# Circle user-controlled wallets (Stage 4)
CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Hosted deliverable storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=

# Publishing deliverables to the live site (worker -> site -> Vercel Blob)
SITE_URL=
PUBLISH_SECRET=

# Owner key for the /inbox page
ADMIN_KEY=
